components:
  schemas:
    Account:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        code:
          type: string
          maxLength: 32
        name:
          type: string
          maxLength: 160
        type:
          $ref: '#/components/schemas/TypeEnum'
        parent:
          type: integer
          nullable: true
        is_system:
          type: boolean
          readOnly: true
        is_control:
          type: boolean
          readOnly: true
        bank_account:
          type: integer
          nullable: true
        is_active:
          type: boolean
      required:
      - code
      - id
      - is_control
      - is_system
      - name
      - type
    AccountTypeEnum:
      enum:
      - CURRENT
      - SAVINGS
      - CASH_BOX
      type: string
      description: |-
        * `CURRENT` - Current
        * `SAVINGS` - Savings
        * `CASH_BOX` - Cash Box
    AccountingPeriod:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 64
        start_date:
          type: string
          format: date
        end_date:
          type: string
          format: date
        status:
          $ref: '#/components/schemas/AccountingPeriodStatusEnum'
      required:
      - end_date
      - id
      - name
      - start_date
    AccountingPeriodStatusEnum:
      enum:
      - OPEN
      - SOFT_CLOSED
      - CLOSED
      type: string
      description: |-
        * `OPEN` - Open
        * `SOFT_CLOSED` - Soft Closed
        * `CLOSED` - Closed
    ActionEnum:
      enum:
      - CREATE
      - UPDATE
      - DELETE
      - LOGIN
      - LOGOUT
      - IMPORT
      type: string
      description: |-
        * `CREATE` - Create
        * `UPDATE` - Update
        * `DELETE` - Delete
        * `LOGIN` - Login
        * `LOGOUT` - Logout
        * `IMPORT` - Import
    AssistantMessage:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        role:
          $ref: '#/components/schemas/AssistantMessageRoleEnum'
        content:
          type: string
        tool_name:
          type: string
          maxLength: 64
        citations: {}
        proposed_action:
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - role
    AssistantMessageRoleEnum:
      enum:
      - user
      - assistant
      - system
      - tool
      type: string
      description: |-
        * `user` - User
        * `assistant` - Assistant
        * `system` - System
        * `tool` - Tool
    AssistantThread:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          maxLength: 255
        created_at:
          type: string
          format: date-time
          readOnly: true
        messages:
          type: array
          items:
            $ref: '#/components/schemas/AssistantMessage'
          readOnly: true
      required:
      - created_at
      - id
      - messages
    AssistantThreadList:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          maxLength: 255
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
    AuditEvent:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        action:
          $ref: '#/components/schemas/ActionEnum'
        entity_type:
          type: string
          maxLength: 64
        entity_id:
          type: string
          maxLength: 64
        description:
          type: string
          maxLength: 255
        metadata: {}
        user:
          type: integer
          nullable: true
        user_email:
          type: string
          format: email
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - action
      - created_at
      - id
      - user_email
    BankAccount:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        account_number_masked:
          type: string
          maxLength: 32
        ifsc:
          type: string
          maxLength: 16
        account_type:
          $ref: '#/components/schemas/AccountTypeEnum'
        opening_balance:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
        opening_as_of:
          type: string
          format: date
          nullable: true
        is_default:
          type: boolean
        is_active:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - name
    BankReconSession:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        account:
          type: integer
        statement:
          type: integer
        status:
          $ref: '#/components/schemas/BankReconSessionStatusEnum'
        gl_balance:
          type: string
          format: decimal
          pattern: ^-?\d{0,14}(?:\.\d{0,2})?$
        statement_balance:
          type: string
          format: decimal
          pattern: ^-?\d{0,14}(?:\.\d{0,2})?$
      required:
      - account
      - id
      - statement
    BankReconSessionStatusEnum:
      enum:
      - OPEN
      - CLOSED
      type: string
      description: |-
        * `OPEN` - Open
        * `CLOSED` - Closed
    BankStatement:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        bank_account:
          type: integer
        bank_account_name:
          type: string
          readOnly: true
        period_start:
          type: string
          format: date
          nullable: true
        period_end:
          type: string
          format: date
          nullable: true
        source_filename:
          type: string
          maxLength: 255
        status:
          $ref: '#/components/schemas/BankStatementStatusEnum'
        preset:
          type: string
          maxLength: 32
        line_count:
          type: string
          readOnly: true
        unmatched_count:
          type: string
          readOnly: true
        lines:
          type: array
          items:
            $ref: '#/components/schemas/BankStatementLine'
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - bank_account
      - bank_account_name
      - created_at
      - id
      - line_count
      - lines
      - unmatched_count
    BankStatementLine:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        statement:
          type: integer
        txn_date:
          type: string
          format: date
        value_date:
          type: string
          format: date
          nullable: true
        amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
        narration:
          type: string
          maxLength: 512
        utr:
          type: string
          maxLength: 64
        balance_after:
          type: string
          format: decimal
          pattern: ^-?\d{0,12}(?:\.\d{0,2})?$
          nullable: true
        match_status:
          $ref: '#/components/schemas/BankStatementLineMatchStatusEnum'
        line_hash:
          type: string
          maxLength: 64
      required:
      - amount
      - id
      - statement
      - txn_date
    BankStatementLineMatchStatusEnum:
      enum:
      - UNMATCHED
      - SUGGESTED
      - MATCHED
      - IGNORED
      type: string
      description: |-
        * `UNMATCHED` - Unmatched
        * `SUGGESTED` - Suggested
        * `MATCHED` - Matched
        * `IGNORED` - Ignored
    BankStatementStatusEnum:
      enum:
      - PREVIEW
      - COMMITTED
      - VOID
      type: string
      description: |-
        * `PREVIEW` - Preview
        * `COMMITTED` - Committed
        * `VOID` - Void
    BatchLot:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        product:
          type: integer
        product_name:
          type: string
          readOnly: true
        batch_no:
          type: string
          maxLength: 64
        expiry_date:
          type: string
          format: date
          nullable: true
        manufacturing_date:
          type: string
          format: date
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - batch_no
      - created_at
      - id
      - product
      - product_name
    BlankEnum:
      enum:
      - ''
    Bom:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        product:
          type: integer
        name:
          type: string
          maxLength: 200
        status:
          $ref: '#/components/schemas/BomStatusEnum'
        lines:
          type: array
          items:
            $ref: '#/components/schemas/BomLine'
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - name
      - product
      - updated_at
    BomLine:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        component:
          type: integer
