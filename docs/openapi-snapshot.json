openapi: 3.0.3
info:
  title: Bizboard API
  version: 1.0.0
  description: Pilot GST billing, inventory, and derived ledgers API (v1). Not a full
    ERP — Manufacturing, Payroll, CRM, live NIC GSP, and WhatsApp Business are out
    of scope.
paths:
  /api/v1/accounting/{report}/:
    get:
      operationId: accounting_retrieve
      parameters:
      - in: path
        name: report
        schema:
          type: string
        required: true
      tags:
      - accounting
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/accounting/accounts/:
    get:
      operationId: accounting_accounts_list
      description: |-
        Base viewset enforcing tenant isolation: querysets filtered by the
        requesting user's company; created rows stamped with company + audit fields.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - accounting
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAccountList'
          description: ''
    post:
      operationId: accounting_accounts_create
      description: |-
        Base viewset enforcing tenant isolation: querysets filtered by the
        requesting user's company; created rows stamped with company + audit fields.
      tags:
      - accounting
      requestBody:
