components:
  schemas:
    Account:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        code:
          type: string
          maxLength: 32
        name:
          type: string
          maxLength: 160
        type:
          $ref: '#/components/schemas/TypeEnum'
        parent:
          type: integer
          nullable: true
        is_system:
          type: boolean
          readOnly: true
        is_control:
          type: boolean
          readOnly: true
        bank_account:
          type: integer
          nullable: true
