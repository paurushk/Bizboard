{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizboard/validation/action_item.schema.json",
  "title": "In-page money action (Graph 1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "surfaces", "writes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
    "title": { "type": "string", "minLength": 8 },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "writes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "notes": { "type": "string" },
    "review_row": { "type": "string" }
  }
}
