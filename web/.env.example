VITE_API_BASE_URL=/api/v1
# Set to true to force mock data even when API is reachable (local/e2e only)
VITE_USE_MOCKS=false
# VITE_USE_MOCKS must never be true in production builds

VITE_ENABLE_GSTR=false
VITE_ENABLE_AI=false
VITE_ENABLE_TALLY=false
VITE_ENABLE_EINVOICE_SUBMIT=false
# Accounting UI defaults on unless set to false (company.accountingEnabled still required)
# VITE_ENABLE_ACCOUNTING=true
VITE_PILOT_ADVANCED=false

# Wave 18D — counter POS MVP (off by default)
VITE_ENABLE_POS=false

# New-owner guided setup (on by default; set false / ENABLE_SETUP_WIZARD=0 to disable)
VITE_ENABLE_SETUP_WIZARD=true
# Use "console" for pilot funnel events until a hosted analytics sink is configured
VITE_ONBOARDING_ANALYTICS=console

# Optional frontend error reporting (BB-000121 / BB-000165). Leave unset to no-op.
# VITE_SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>
