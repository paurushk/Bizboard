# BizBoard — FROZEN PILOT flag profile (frontend)
# ---------------------------------------------------------------------------
# The web counterpart of backend/.env.pilot.example. Every freeze-relevant
# VITE_* flag is stated explicitly. See docs/FREEZE_SCOPE.md.
#
# Ratified by: __________________  Date: __________
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=/api/v1
# Never true in a pilot/production build.
VITE_USE_MOCKS=false

# === SUPPORTED (ON) ===
VITE_ENABLE_SETUP_WIZARD=true
# D1=ON — counter POS (A23)
VITE_ENABLE_POS=true
VITE_ENABLE_ATOMIC_POS_CHECKOUT=true
# D2=ON — TDS / TCS (A24)
VITE_ENABLE_TDS=true
# D4=ON — OTP login (A26); backend host also needs SMS_PROVIDER
VITE_ENABLE_OTP=true
# D5=YES — a pilot company uses books, so the accounting UI ships
VITE_ENABLE_ACCOUNTING=true

# === NOT SUPPORTED (frozen OFF) — docs/FREEZE_SCOPE.md section B ===
VITE_ENABLE_GSTR=false
VITE_ENABLE_AI=false
VITE_ENABLE_TALLY=false
VITE_ENABLE_EINVOICE_SUBMIT=false
VITE_ENABLE_MANUFACTURING=false
VITE_ENABLE_PAYROLL=false
VITE_ENABLE_CRM=false
# Master demo switch — OFF disables the advanced surfaces as a group.
VITE_PILOT_ADVANCED=false
# Help v2 pre-GA — help v1 is the supported surface.
VITE_HELP_V2=false

# Note: the accounting UI is still gated by company.accountingEnabled at runtime.

# Decisions D1-D5 resolved 2026-09-08 (all ON) — see docs/FREEZE_SCOPE.md §D.

# === Ops ===
# Pilot funnel events to console until a hosted analytics sink is configured.
VITE_ONBOARDING_ANALYTICS=console
# VITE_SENTRY_DSN=            # optional frontend error reporting
