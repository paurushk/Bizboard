#!/bin/sh
# M1-034: refuse to commit a populated .env at the repo root. .env is already
# git-ignored, so this only fires if someone force-adds it (`git add -f`) or a
# tool stops honoring the ignore — belt-and-suspenders, not a replacement for
# .gitignore.
set -e

if git diff --cached --name-only --diff-filter=ACM | grep -qxE '\.env(\.dev|\.staging)?$'; then
  echo "error: refusing to commit '.env', '.env.dev', or '.env.staging' (local secrets)." >&2
  echo "       Unstage with: git restore --staged .env .env.dev .env.staging" >&2
  exit 1
fi

exit 0
