# GlitchTip on its own VM (docker-compose.glitchtip.yml, mode B). Copy to .env.glitchtip (gitignored).
# Inside a Bizboard stack (mode A) the same GLITCHTIP_* names go in that stack's env file instead.
# Runbook: docs/ops/GLITCHTIP.md
#
# Random values:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"   (secret key, passwords)
#   python -c "import uuid; print(uuid.uuid4().hex)"               (project keys)
#   python -c "import secrets; print(secrets.token_hex(32))"       (ops token)

GLITCHTIP_SECRET_KEY=change-me
GLITCHTIP_DB_PASSWORD=change-me

# Public URL of the UI. Local: http://localhost:8095. Host: https://errors.<domain>
GLITCHTIP_DOMAIN=http://localhost:8095
GLITCHTIP_PORT=8095

# First admin (created by glitchtip-init) and the people alerts go to.
GLITCHTIP_ADMIN_EMAIL=
GLITCHTIP_ADMIN_PASSWORD=
GLITCHTIP_ALERT_EMAILS=
# Free phone push: install the ntfy app, subscribe to a long random topic, put its URL here.
GLITCHTIP_ALERT_NTFY_URL=
# smtp://user:password@smtp.host:587  (consolemail:// = log only)
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_FROM_EMAIL=errors@localhost

# Fixed project keys, so the app's DSNs are known before the first start.
GLITCHTIP_API_KEY=
GLITCHTIP_WEB_KEY=
# Read-only token the Bizboard API uses for /admin/ops/errors/ (same value on the app host).
ERROR_TRACKER_TOKEN=

# Mode B: how the app host reaches this VM, and what the uptime monitors probe.
GLITCHTIP_DSN_BASE_URL=https://errors.example.in
GLITCHTIP_MONITOR_BASE_URL=https://app.example.in
# Monitors here probe a public URL, so uptime checks on private addresses stay blocked.
GLITCHTIP_ALLOW_PRIVATE_IPS=false

GLITCHTIP_RETENTION_DAYS=90
# Nightly `run --rm glitchtip-backup` (scripts/backup.sh): same BACKUP_GPG_RECIPIENT /
# BACKUP_AGE_RECIPIENT / BACKUP_OFFSITE_CMD rules as the app's dump.
GLITCHTIP_BACKUP_DIR=./backups/glitchtip
