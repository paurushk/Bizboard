# Docker Compose DEV template. Copy to .env.dev (gitignored) or keep using
# the existing root .env — both are development-only.
# Never copy this file to a shared/staging/prod host.
#
#   .\scripts\compose-env.ps1 dev up -d
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d
#
# Bare runserver / SQLite (no Docker)? Use backend/.env.example instead.

DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me-long-random-secret-key-32chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com,.cfargotunnel.com
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173,https://*.trycloudflare.com,https://*.cfargotunnel.com

POSTGRES_DB=bizboard
POSTGRES_USER=bizboard
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://bizboard:change-me-strong-password@db:5432/bizboard
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

OTP_PEPPER=dev-only-otp-pepper-change-me
OTP_DEBUG_ECHO=1
OTP_ENABLED=0
SMS_PROVIDER=console
ADMIN_ENABLED=0
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

SANDBOX_WEBHOOK_SECRET=dev-sandbox-webhook-secret-change-me
POSTGRES_RLS_ENABLED=0

GSP_FERNET_KEY=
GSP_LIVE_ENABLED=0
GSP_CERTIFIED=0

DEFAULT_FROM_EMAIL=billing@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

LLM_PROVIDER=openai
LLM_MODEL=
CELERY_TIMEZONE=Asia/Kolkata
ENABLE_SETUP_WIZARD=1

APP_BIND=127.0.0.1
APP_PORT=80
