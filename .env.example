DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me-long-random-secret-key-32chars
# LAN / phone access: include the host or IP in DJANGO_ALLOWED_HOSTS (nginx forwards the real Host).
# Cloudflare quick tunnel: include .trycloudflare.com (leading dot = all subdomains).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com,.cfargotunnel.com
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173,https://*.trycloudflare.com,https://*.cfargotunnel.com

POSTGRES_DB=bizboard
POSTGRES_USER=bizboard
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://bizboard:change-me-strong-password@db:5432/bizboard
# Required by docker-compose redis --requirepass
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0
# Production managed Redis: use rediss:// with TLS (BB-000375).

# --- Auth / OTP / Admin (BB-000308 / BB-000332 / BB-000347) ---
OTP_PEPPER=dev-only-otp-pepper-change-me
# Echo OTP only for local console testing (never production).
OTP_DEBUG_ECHO=1
# Enable OTP when using a real SMS provider (or with console+OTP_DEBUG_ECHO locally).
OTP_ENABLED=0
SMS_PROVIDER=console
ADMIN_ENABLED=0
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# JWT_REFRESH_COOKIE_NAME=bb_refresh
# JWT_ACCESS_COOKIE_NAME=bb_access
# JWT_REFRESH_COOKIE_SAMESITE=Lax
# SameSite=None requires JWT_REFRESH_ALLOW_SAMESITE_NONE=1 (BB-000353).

# --- Payments / webhooks ---
SANDBOX_WEBHOOK_SECRET=dev-sandbox-webhook-secret-change-me

# --- GSP / e-Invoice credentials encryption ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GSP_FERNET_KEY=
# TENANT_EXPORT_FERNET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# GSP_LIVE_ENABLED=0
# GSP_CERTIFIED=0
# GSP_PROVIDER=custom

# --- AI / Insights ---
# AI_MONTHLY_TOKEN_BUDGET_DEFAULT=500000
# SENTRY_DSN=

# Help v2 allowlist (comma-separated company ids). Pre-GA default off.
# HELP_V2_COMPANY_ALLOWLIST=

DEFAULT_FROM_EMAIL=billing@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

LLM_PROVIDER=openai
# OPENAI_API_KEY=
LLM_MODEL=
# Vision extract for dense GST bill photos (unset → gpt-4o). Chat still uses LLM_MODEL.
# LLM_BILL_MODEL=gpt-4o

CELERY_TIMEZONE=Asia/Kolkata

# Guided Owner setup (on by default; set 0 to fall back to checklist-only)
ENABLE_SETUP_WIZARD=1
