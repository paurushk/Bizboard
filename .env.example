DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# LAN IPs: nginx remaps numeric Host → localhost for /api/.
# Cloudflare quick tunnel: include .trycloudflare.com (leading dot = all subdomains).
# Custom tunnel domain: add that hostname too, e.g. app.yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com,.cfargotunnel.com
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

POSTGRES_DB=bizboard
POSTGRES_USER=bizboard
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://bizboard:change-me@db:5432/bizboard
REDIS_URL=redis://redis:6379/0

DEFAULT_FROM_EMAIL=billing@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# LLM — purchase bill / rate-list extraction (openai | deepseek | claude)
LLM_PROVIDER=openai
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ANTHROPIC_API_KEY=
# Leave LLM_MODEL empty for provider default. Do not put a comment on the LLM_MODEL= line.
LLM_MODEL=
