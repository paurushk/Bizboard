# Production environment template — copy to .env and fill secrets.
# docker compose --env-file .env.production up --build
#
# M1-028: the local Compose templates are .env.example / .env.dev.example
# (DEV) and .env.staging.example (isolated staging). backend/.env.example is
# bare `manage.py runserver`. JWT_REFRESH_DAYS is deliberately shorter here (2)
# than in dev (7) — not a drift, a prod policy.

DJANGO_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-long-random-secret-at-least-40-chars
DJANGO_ALLOWED_HOSTS=your.domain.com
FRONTEND_URL=https://your.domain.com
CORS_ALLOWED_ORIGINS=https://your.domain.com
CSRF_TRUSTED_ORIGINS=https://your.domain.com
ENABLE_API_DOCS=0

# --- Auth / OTP / Admin (BB-000308) ---
ADMIN_ENABLED=0
OTP_DEBUG_ECHO=0
SMS_PROVIDER=
OTP_PEPPER=replace-with-dedicated-otp-pepper-not-secret-key
JWT_REFRESH_DAYS=2
JWT_ACCESS_MINUTES=15

# --- Payments / webhooks ---
# Required in production/staging for sandbox webhook HMAC.
SANDBOX_WEBHOOK_SECRET=replace-with-long-random-webhook-secret

# --- GSP / e-Invoice ---
# Fernet key for encrypting GSP/gateway credentials (required in production).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GSP_FERNET_KEY=
# TENANT_EXPORT_FERNET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
GSP_LIVE_ENABLED=0
GSP_CERTIFIED=0
# GSP_PROVIDER=custom
# GSP_LIVE_BASE_URL=

# Required in production/staging — console email backend is rejected at boot/send.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=billing@your.domain.com
REQUIRE_SMTP=1
USE_TLS=1
POSTGRES_DB=bizboard
POSTGRES_USER=bizboard
POSTGRES_PASSWORD=CHANGE_ME_STRONG
DATABASE_URL=postgresql://bizboard:CHANGE_ME_STRONG@db:5432/bizboard
REDIS_PASSWORD=CHANGE_ME_REDIS
# Prefer TLS on managed Redis in cloud: rediss://:PASSWORD@host:6380/0 (BB-000375)
REDIS_URL=redis://:CHANGE_ME_REDIS@redis:6379/0
CELERY_TASK_ALWAYS_EAGER=0
CELERY_TIMEZONE=UTC

# Freeze-supported ON (A19 / A23 / A24). Paid-plan JSON can still deny per tenant.
ENABLE_POS=1
ENABLE_TDS=1
ENABLE_SETUP_WIZARD=1

# Table B / known-limitation flags — pin OFF. Django defaults match these;
# listing them here so a copied .env cannot silently enable dark modules.
ENABLE_GSTR=0
ENABLE_GSTN_JSON=0
ENABLE_TALLY=0
ENABLE_MANUFACTURING=0
ENABLE_PAYROLL=0
ENABLE_CRM=0
ENABLE_FIXED_ASSETS=0
ENABLE_BOE=0
ENABLE_WHATSAPP_CLOUD=0
ENABLE_ACCOUNT_AGGREGATOR=0
GSP_LIVE_ENABLED=0

# Table B: stay off until RLS soak on staging is proven (non-superuser DB role).
POSTGRES_RLS_ENABLED=0

# --- AI / Insights ---
# AI_MONTHLY_TOKEN_BUDGET_DEFAULT=500000

# Optional
# --- Observability (O-Gate 1). Host env only — never commit real DSNs/tokens. ---
# METRICS_TOKEN=                      # required to scrape GET /metrics (Authorization: Bearer …)
# SENTRY_DSN=
# SENTRY_RELEASE=                     # deploy SHA or tag
# SENTRY_TRACES_SAMPLE_RATE=0.1
# M1-028: openai | deepseek | claude — keep consistent with .env.example /
# backend/.env.example.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ANTHROPIC_API_KEY=
# LLM_BILL_MODEL=gpt-4o
