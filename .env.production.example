# Production environment template — copy to .env and fill secrets.
# docker compose --env-file .env.production up --build

DJANGO_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-long-random-secret-at-least-32-chars
DJANGO_ALLOWED_HOSTS=your.domain.com
CORS_ALLOWED_ORIGINS=https://your.domain.com
ENABLE_API_DOCS=0
OTP_DEBUG_ECHO=0
SMS_PROVIDER=
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=billing@your.domain.com
USE_TLS=1
JWT_REFRESH_DAYS=2
DATABASE_URL=postgresql://bizboard:CHANGE_ME@db:5432/bizboard
REDIS_URL=redis://redis:6379/0
