# BizBoard — FROZEN PILOT flag profile (backend)
# ---------------------------------------------------------------------------
# This file is the single source of truth for "what is on" in a pilot
# deployment during the freeze. It lists EVERY freeze-relevant feature flag
# explicitly, even where the value equals the code default, so the frozen
# surface is one file and not tribal knowledge.
#
# Ratified by: __________________  Date: __________  (see docs/FREEZE_SCOPE.md)
#
# Rules:
#  - Do not deviate from these values in a pilot host without a written
#    exception recorded in docs/FREEZE_SCOPE.md.
#  - This is a FLAG profile, not a full env file. Copy your real
#    secrets/DB/Redis/email config from ../.env.production.example and then
#    apply the flags below on top.
#  - A Phase 1 config-consistency guard asserts every flag here matches a
#    real _env_bool("X") in backend/config/settings.py.
# ---------------------------------------------------------------------------

# === SUPPORTED (must be ON) ===
# A19 — first-run guided setup wizard
ENABLE_SETUP_WIZARD=1

# A23 (D1=ON) — counter POS checkout
ENABLE_POS=1

# A24 (D2=ON) — TDS / TCS (194Q / 206C)
ENABLE_TDS=1

# A25 (D3=ON, sandbox) — online payment collection via gateway webhook.
# At least one of the two providers below must have real sandbox credentials,
# and SANDBOX_WEBHOOK_SECRET must be set, on the pilot host and in CI.
ENABLE_CASHFREE=1
ENABLE_PAYU=1
# SANDBOX_WEBHOOK_SECRET=<sandbox-hmac-secret>
# CASHFREE_* / PAYU_* credentials: see ../.env.production.example

# A26 (D4=ON) — OTP login. Requires a live SMS provider on the pilot host:
OTP_ENABLED=1
SMS_PROVIDER=msg91          # or: twilio  (console/stub is rejected in prod/staging)

# === NOT SUPPORTED (frozen OFF) — see docs/FREEZE_SCOPE.md section B ===
# GST returns / portal. A trial subscription lifts ENABLE_GSTR and
# ENABLE_GSTR_EXTENDED via trial_plan_modules. GSTN JSON stays false
# (TRIAL_HELD_FALSE) and this process flag stays 0.
ENABLE_GSTR=0
# GSTR-2B/4/6/7/8/9 nav (UX programme flag); frozen OFF, demo/staging turn it on.
ENABLE_GSTR_EXTENDED=0
ENABLE_GSTN_JSON=0
# Live NIC e-invoice / e-way (GSP)
GSP_LIVE_ENABLED=0
GSP_CERTIFIED=0
# Tally migration / sync
ENABLE_TALLY=0
# Scope revision 2026-09-09b — KNOWN LIMITATIONS demoted from the D6-D14 tranche
ENABLE_FIXED_ASSETS=0
ENABLE_BOE=0
# D15 — ARCH-05 statutory compliance (drug licence 20B/21B + FSSAI). Off for
# the ARCH-03 pilot; flip per-deployment when a pharma/food pilot is provisioned.
ENABLE_ARCH05_STATUTORY_FORMS=0
# Dark modules
ENABLE_MANUFACTURING=0
ENABLE_PAYROLL=0
ENABLE_CRM=0
# Messaging / banking integrations
ENABLE_WHATSAPP_CLOUD=0
ENABLE_ACCOUNT_AGGREGATOR=0
# Postgres row-level security. Production and staging on PostgreSQL refuse to start with this
# off (BUG-SEC-019): set 1 and use a non-superuser database role (a superuser bypasses FORCE RLS).
# It may stay 0 for local SQLite and development.
POSTGRES_RLS_ENABLED=1

# Decisions D1-D5 were resolved 2026-09-08 (all ON) — the POS / TDS / gateway /
# OTP flags are in the SUPPORTED block above. See docs/FREEZE_SCOPE.md section D.

# === Dev-only tooling — OFF in any pilot host (listed for completeness) ===
DJANGO_DEBUG=0
ENABLE_API_DOCS=0
ADMIN_ENABLED=0

# === Per-company (not env) — tracked here for the freeze record ===
# company.accounting_enabled  -> D5 = YES, at least one pilot company uses books,
#                                so FG-2a/gl (balanced journals, TB=0, subledger
#                                reconciliation, closed-period) is a HARD freeze gate.
# company.ai_features_enabled -> frozen OFF for all pilot companies (section B).
# company.feature_flags JSON  -> no dark-module grants during the freeze.

# Owner and accountant must enrol TOTP. An access cookie issued before this
# flag was turned on stays valid for its 15-minute lifetime; the next refresh
# returns enrolment instead of a new session. Do not mass-revoke on deploy.
MFA_ENFORCE_FOR_MONEY_ROLES=1
# Set a Fernet key before the first enrolled user. Rotation is comma-separated,
# newest first. The derived key an empty setting used is:
#   urlsafe_b64encode(sha256("bizboard-mfa|" + SECRET_KEY))
# Keep it in the list until `manage.py reencrypt_mfa_secrets` has run.
# Required in production and staging: the server refuses to start with it empty.
# MFA_ENCRYPTION_KEY=
# Required in production and staging: url-safe base64 of 32 random bytes. It seals bank account
# numbers and tax-portal secrets (AES-256-GCM). Generate with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# PLANWAVE_DATA_KEY=
# Lost phone and recovery codes: `manage.py reset_user_mfa --email user@example.com`
# (host command, not an API). Turning enforcement off requires the waiver:
# MFA_ENFORCE_WAIVER=1
