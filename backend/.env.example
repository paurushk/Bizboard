# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Auth / OTP / Admin (BB-000308) ---
# Set to 1 to test the OTP login flow locally (no real SMS gateway is wired
# up yet, so OTP requests are otherwise blocked outside this explicit opt-in).
OTP_DEBUG_ECHO=1
# OTP_PEPPER=replace-with-dedicated-otp-pepper
# SMS_PROVIDER=console
# ADMIN_ENABLED=1
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7

# --- Payments / webhooks ---
# SANDBOX_WEBHOOK_SECRET=

# Database — leave DATABASE_URL unset to fall back to local SQLite (dev/test).
# Production (PostgreSQL):
# DATABASE_URL=postgresql://bizboard:bizboard@db:5432/bizboard

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
# 0 = use a real Celery worker (recommended). 1 = run tasks in-process (local/dev without Redis).
CELERY_TASK_ALWAYS_EAGER=0
# DeepSeek: set LLM_MODEL to a vision-capable model (default deepseek-vl2).

# CORS (comma separated origins for the web frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (console backend used when unset)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=billing@example.com

# Docker compose helpers
POSTGRES_DB=bizboard
POSTGRES_USER=bizboard
POSTGRES_PASSWORD=bizboard
APP_PORT=80

# LLM — purchase bill / rate-list extraction (openai | deepseek | claude)
LLM_PROVIDER=openai
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ANTHROPIC_API_KEY=
# LLM_MODEL=

# --- AI / Insights ---
# AI_MONTHLY_TOKEN_BUDGET_DEFAULT=500000

# Guided Owner setup (on by default; set 0 to fall back to checklist-only)
ENABLE_SETUP_WIZARD=1

# Optional Fernet key for GSP credentials. If unset, derived from DJANGO_SECRET_KEY.
# GSP_FERNET_KEY=
# GSP_LIVE_ENABLED=0
# GSP_CERTIFIED=0
# GSP_PROVIDER=custom
# GSP_LIVE_BASE_URL=
# TENANT_EXPORT_FERNET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
