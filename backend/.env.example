# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave DATABASE_URL unset to fall back to local SQLite (dev/test).
# Production (PostgreSQL):
# DATABASE_URL=postgresql://bizboard:bizboard@db:5432/bizboard

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
# 1 = run Celery tasks synchronously in-process (no worker needed, dev/test default)
CELERY_TASK_ALWAYS_EAGER=1

# CORS (comma separated origins for the web frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (console backend used when unset)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=billing@example.com

# Docker compose helpers
POSTGRES_DB=bizboard
POSTGRES_USER=bizboard
POSTGRES_PASSWORD=bizboard
APP_PORT=80
