# Local Compose STAGING template — production-like Django gates, sandbox/test
# credentials only. Copy to .env.staging (gitignored) and change the secrets.
# Never put production secrets, live Razorpay, live GSP, or real GSTIN/PII here.
#
#   copy .env.staging.example .env.staging
#   .\scripts\compose-env.ps1 staging --profile migrate build
#   .\scripts\compose-env.ps1 staging up -d db redis
#   .\scripts\compose-env.ps1 staging --profile migrate run --rm migrate
#   scripts/staging-db-role.sh                     # creates the NOBYPASSRLS app role (APP_DB_*)
#   .\scripts\compose-env.ps1 staging up -d
#   .\scripts\compose-env.ps1 staging --profile migrate run --rm migrate python manage.py seed_staging
#
# Loopback HTTP on APP_PORT=8081. For a Cloudflare quick tunnel, also add:
#   DJANGO_ALLOWED_HOSTS=...,.trycloudflare.com,.cfargotunnel.com
#   CSRF_TRUSTED_ORIGINS=...,https://*.trycloudflare.com,https://*.cfargotunnel.com
#   CORS_ALLOWED_ORIGINS=...,https://<current-subdomain>.trycloudflare.com
#   CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+\.trycloudflare\.com$
#   NUM_TRUSTED_PROXIES=2   (Cloudflare adds the client hop, nginx adds the tunnel's)
# Then recreate api/worker/beat. The tunnel URL is HTTPS — use that to sign in.
# Production remains .env.production.example + docker-compose.prod.yml.

DJANGO_ENV=staging
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=local-staging-only-secret-key-not-for-production-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://127.0.0.1:8081
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
ENABLE_API_DOCS=1
# Proxies that append to X-Forwarded-For (throttle / login-lock client IP). nginx only = 1;
# behind a Cloudflare tunnel = 2. See docs/ops/HOSTED_STAGING.md.
NUM_TRUSTED_PROXIES=1

ADMIN_ENABLED=0
OTP_DEBUG_ECHO=0
OTP_ENABLED=0
SMS_PROVIDER=off
OTP_PEPPER=local-staging-only-otp-pepper-not-for-production

# Local-staging-only keys, committed on purpose. Generate your own for any shared environment.
# MFA secrets (Fernet) and bank-account / tax-portal secrets (AES-256-GCM, url-safe base64 of 32 bytes).
MFA_ENCRYPTION_KEY=
PLANWAVE_DATA_KEY=
JWT_REFRESH_DAYS=2
JWT_ACCESS_MINUTES=15

SANDBOX_WEBHOOK_SECRET=local-staging-sandbox-webhook-secret-change-me
# Soak default ON for staging. Superuser DB roles bypass FORCE RLS — use a
# non-superuser role before treating this as proven. Production stays 0.
POSTGRES_RLS_ENABLED=1

# Generate a unique key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GSP_FERNET_KEY=mhJ9ODoOTToM_7jA58LLwtqij6JihwV_n-JwuQj3Zlk=
GSP_LIVE_ENABLED=0
GSP_CERTIFIED=0

# --- Telegram bot notifications (single platform-wide bot; @BotFather) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# --- Ops paging (no-infra PagerDuty/Sentry-alert alternative) ---
# See docs/ops/OGATE_HUMAN.md. Sentry alert rule / uptime monitor -> this
# token-guarded webhook -> OPS_TELEGRAM_CHAT_ID.
# OPS_ALERT_TOKEN=
# OPS_TELEGRAM_CHAT_ID=

# Required to boot (Django rejects console email in staging). Local staging
# does not send mail — use a trap/host you control, never production SMTP.
# If staging should actually deliver to a trap inbox, a separate Resend
# domain/API key works too (EMAIL_HOST=smtp.resend.com, EMAIL_HOST_USER=resend) —
# never reuse the production Resend key here.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=billing@your.domain.com
REQUIRE_SMTP=1
USE_TLS=1

# STG-17: api/worker/beat connect as this NON-superuser role so FORCE RLS applies.
# POSTGRES_USER (below) is the owner/superuser used only by migrate/backup/restore/seed.
# DATABASE_URL below is ignored by docker-compose.staging.yml (it builds its own).
APP_DB_USER=bizboard_app
APP_DB_PASSWORD=staging-only-app-role-password-change-me

# Backups fail closed without a recipient. Local-only staging with seed data may use
# BACKUP_ALLOW_UNENCRYPTED=1; any shared host must set BACKUP_AGE_RECIPIENT (and
# RESTORE_AGE_IDENTITY to restore) or BACKUP_GPG_RECIPIENT.
BACKUP_ALLOW_UNENCRYPTED=1
# If the pg_dump role is ever not an owner/superuser, set BACKUP_DB_USER/BACKUP_DB_PASSWORD.

# Uploads are refused unless ClamAV is reachable. Local staging has no clamav container.
CLAMAV_OPTIONAL=1

# MFA for money roles is enforced by default in staging. To waive for a walkthrough set
# MFA_ENFORCE_FOR_MONEY_ROLES=0 AND MFA_ENFORCE_WAIVER=1 (record it); preferred: enrol TOTP.

POSTGRES_DB=bizboard_staging
POSTGRES_USER=bizboard_staging
POSTGRES_PASSWORD=staging-only-change-me-strong-password
DATABASE_URL=postgresql://bizboard_staging:staging-only-change-me-strong-password@db:5432/bizboard_staging
REDIS_PASSWORD=staging-only-redis-password-change-me
REDIS_URL=redis://:staging-only-redis-password-change-me@redis:6379/0
CELERY_TASK_ALWAYS_EAGER=0
CELERY_TIMEZONE=Asia/Kolkata

LLM_PROVIDER=openai
LLM_MODEL=
ENABLE_SETUP_WIZARD=1
ENABLE_POS=1
ENABLE_TDS=1

# Table B / known-limitation flags — pin OFF (same as production). Staging
# soak must not enable GSTR screens, manufacturing, payroll, CRM, Tally, FA, BoE.
ENABLE_GSTR=0
ENABLE_GSTN_JSON=0
ENABLE_TALLY=0
ENABLE_MANUFACTURING=0
ENABLE_PAYROLL=0
ENABLE_CRM=0
ENABLE_FIXED_ASSETS=0
ENABLE_BOE=0
ENABLE_WHATSAPP_CLOUD=0
ENABLE_TELEGRAM=0
ENABLE_ACCOUNT_AGGREGATOR=0
GSP_LIVE_ENABLED=0

APP_BIND=127.0.0.1
APP_PORT=8081

# --- Observability (O-Gate 1). Host env only — never commit real DSNs/tokens. ---
# Local staging scrape token (not production). OG1-H5 on a live host still uses a
# long random secret. Playbook: docs/ops/OGATE_HUMAN.md
METRICS_TOKEN=local-staging-only-metrics-token-change-me
# SENTRY_DSN=
# SENTRY_RELEASE=                     # deploy SHA or tag
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_BROWSER_DSN=                 # same value the SPA was built with (VITE_SENTRY_DSN);
#                                     # the API relays browser reports only to it
# SPA: set VITE_SENTRY_DSN (compose build arg / web/.env) and rebuild the frontend image.
# Self-hosted GlitchTip instead of Sentry: docs/ops/GLITCHTIP.md
# --- Error tracking: self-hosted GlitchTip in this stack (docs/ops/GLITCHTIP.md) ---
# Uncomment to run it with the app; glitchtip-init prints the DSNs to paste above.
# COMPOSE_PROFILES=errors
# Also add "api" to DJANGO_ALLOWED_HOSTS: the uptime monitors call http://api:8000 on the
# stack network, and Django refuses hosts it does not list.
# GLITCHTIP_SECRET_KEY=                # long random
# GLITCHTIP_DB_PASSWORD=               # long random
# GLITCHTIP_PORT=8096                   # UI on 127.0.0.1 only; dev uses 8095
# GLITCHTIP_DOMAIN=http://localhost:8096
# GLITCHTIP_ADMIN_EMAIL=
# GLITCHTIP_ADMIN_PASSWORD=            # 12+ characters
# GLITCHTIP_API_KEY=                   # 32 hex: SENTRY_DSN=http://<key>@glitchtip:8000/1
# GLITCHTIP_WEB_KEY=                   # 32 hex: SENTRY_BROWSER_DSN and VITE_SENTRY_DSN=http://<key>@glitchtip:8000/2
# GLITCHTIP_ALERT_EMAILS=              # comma-separated on-call addresses
# GLITCHTIP_ALERT_NTFY_URL=            # https://ntfy.sh/<secret topic>: free push to the on-call phone
# GLITCHTIP_EMAIL_URL=smtp://user:password@smtp.host:587
# Staff error page in Django admin (/admin/ops/errors/) and the tracker-down watcher:
# ERROR_TRACKER_API_URL=http://glitchtip:8000
# ERROR_TRACKER_UI_URL=http://localhost:8096
# ERROR_TRACKER_TOKEN=                 # 64 hex; glitchtip-init creates the token with this value
